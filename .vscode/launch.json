{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Debug",
            "type": "dotnet-studio-debug",
            "request": "launch",
            "preLaunchTask": ".NET Build Project Hidden (Debug)",
            "program": "${input:pickAssemblyDebug}",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "presentation": {
                "hidden": false,
                "group": ".NET",
                "order": 1
            },
            "args": [],
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": ".NET Release",
            "type": "dotnet-studio-debug",
            "request": "launch",
            "preLaunchTask": ".NET Build Project Hidden (Release)",
            "program": "${input:pickAssemblyRelease}",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "presentation": {
                "hidden": false,
                "group": ".NET",
                "order": 2
            },
            "args": [],
            "internalConsoleOptions": "neverOpen"
        }
    ],
    "inputs": [
        {
            "id": "pickAssemblyDebug",
            "type": "command",
            "command": "dotnet-studio.getPickedAssemblyPath",
            "args": {
                "include": "**/*.csproj",
                "acceptIfOneFile": true,
                "configuration": "Debug"
            }
        },
        {
            "id": "pickAssemblyRelease",
            "type": "command",
            "command": "dotnet-studio.getPickedAssemblyPath",
            "args": {
                "include": "**/*.csproj",
                "acceptIfOneFile": true,
                "configuration": "Release"
            }
        }
    ]
}
