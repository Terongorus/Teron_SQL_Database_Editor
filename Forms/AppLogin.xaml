<Window x:Class="AzureEditor.AppLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Connection Creation" Height="195" Width="384"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label x:Name="nickname_label" Content="Name:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="86,20,0,0"/>
        <TextBox x:Name="nickname_textbox" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,23,0,0"/>

        <Label x:Name="username_label" Content="Username:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="66,52,0,0"/>
        <TextBox x:Name="username_input" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,55,0,0"/>

        <Label x:Name="password_label" Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="68,78,0,0"/>
        <PasswordBox x:Name="password_input" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,81,0,0"/>

        <Label x:Name="conn_string_label" Content="Connection string:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,104,0,0"/>
        <TextBox x:Name="conn_string_input" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,107,0,0"/>

        <Button x:Name="cancel_button" Content="Cancel" Width="75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="159,160,0,0" Click="cancel_button_Click"/>
        <Button x:Name="connect_button" Content="Add Connection" Width="132" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,160,0,0" Click="connect_button_Click"/>
    </Grid>
</Window>
