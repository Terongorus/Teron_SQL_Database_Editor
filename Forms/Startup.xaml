<Window x:Class="Startup.Startup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form1" Height="450" Width="800">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Button x:Name="azure_open" Content="Azure SQL Editor" Width="150" Height="50" Margin="3" Click="azure_open_Click"/>
        <Button x:Name="warcraft_open" Content="Warcraft DBC Editor" Width="150" Height="50" Margin="3" HorizontalAlignment="Center" Click="warcraft_open_Click"/>
    </StackPanel>
</Window>
