<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ProjectGuid>{D5C8704C-7C03-4DE3-B40F-36E333B8EB6A}</ProjectGuid>
    <RootNamespace>TeronSQLDatabaseEditor</RootNamespace>
    <AssemblyName>TeronSQLDatabaseEditor</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>WinExe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Teron SQL Database Editor (TSDE)</Product>
    <AssemblyTitle>TeronSQLDatabaseEditor</AssemblyTitle>
    <Description>A powerful database editing tool. Works with any SQL database.</Description>
    <Company>Terongorus</Company>
    <Copyright>Copyright © 2026 Terongorus</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <MajorMinorPatchVersion>3.0.1</MajorMinorPatchVersion>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
  </PropertyGroup>

  <Target Name="IncrementBuildNumber" BeforeTargets="BeforeBuild">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PreviousBuildNumber Condition="'@(_BuildNumberLine)' != ''">@(_BuildNumberLine)</_PreviousBuildNumber>
      <_PreviousBuildNumber Condition="'$(_PreviousBuildNumber)' == ''">0</_PreviousBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
    <PropertyGroup>
      <AssemblyVersion>$(MajorMinorPatchVersion).$(BuildNumber)</AssemblyVersion>
      <FileVersion>$(MajorMinorPatchVersion).$(BuildNumber)</FileVersion>
      <Version>$(MajorMinorPatchVersion).$(BuildNumber)</Version>
    </PropertyGroup>
  </Target>

  <Target Name="BuildInstaller" AfterTargets="Publish">
    <PropertyGroup>
      <_InstallerArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_InstallerArch>
      <_InstallerArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</_InstallerArch>
      <_ISCCPath Condition="Exists('$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe')">$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe</_ISCCPath>
      <_ISCCPath Condition="'$(_ISCCPath)' == '' AND Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</_ISCCPath>
      <_ISCCPath Condition="'$(_ISCCPath)' == '' AND Exists('C:\Program Files\Inno Setup 6\ISCC.exe')">C:\Program Files\Inno Setup 6\ISCC.exe</_ISCCPath>
    </PropertyGroup>

    <Warning Condition="'$(_InstallerArch)' == ''" Text="Skipping installer packaging: unrecognized RuntimeIdentifier '$(RuntimeIdentifier)'." />
    <Warning Condition="'$(_InstallerArch)' != '' AND '$(_ISCCPath)' == ''" Text="Skipping installer packaging: Inno Setup (ISCC.exe) not found. Install it from https://jrsoftware.org/isinfo.php to enable automatic installer creation." />

    <Exec Command="&quot;$(_ISCCPath)&quot; /DMyAppVersion=$(FileVersion) /DMyAppArch=$(_InstallerArch) /DPublishDir=&quot;$(MSBuildProjectDirectory)\$(PublishDir)\&quot; &quot;$(MSBuildProjectDirectory)\Installer\Setup.iss&quot;"
          Condition="'$(_InstallerArch)' != '' AND '$(_ISCCPath)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.53.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.3" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.83.3" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Services\AppInfo.cs" />
    <Compile Include="Services\Globals.cs" />
    <Compile Include="Services\HelperFunctions.cs" />
    <Compile Include="Services\DataRequest.cs" />
    <Compile Include="Services\ExportQueryResults.cs" />
    <Compile Include="Services\App.cs" />
    <Compile Include="Forms\Startup.xaml.cs">
      <DependentUpon>Startup.xaml</DependentUpon>
    </Compile>
    <Compile Include="Forms\AppForm.xaml.cs">
      <DependentUpon>AppForm.xaml</DependentUpon>
    </Compile>
    <Compile Include="Forms\AppDelete.xaml.cs">
      <DependentUpon>AppDelete.xaml</DependentUpon>
    </Compile>
    <Compile Include="Forms\AppLogin.xaml.cs">
      <DependentUpon>AppLogin.xaml</DependentUpon>
    </Compile>
    <Compile Include="Forms\DBCEditor.xaml.cs">
      <DependentUpon>DBCEditor.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
	<Content Include="Resources\Definitions\*.*" CopyToOutputDirectory="PreserveNewest" />
	<Content Include="Resources\Icons\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Directory.Build.props relocates obj\ under Build\obj\$(MSBuildProjectName)\, but the implicit
    item globs (**/*.cs etc.) don't reliably exclude a STALE sibling Configuration/Platform folder
    left there from an earlier build - its generated .g.cs files then get swept in as duplicate
    source against the current build's own copy (CS0102/CS0111/CS8646). This project's own Compile
    items are already explicit (EnableDefaultCompileItems is false above, so nothing under Build\
    was ever going to be swept via *that* glob) - this ItemGroup is defense-in-depth for the other
    implicit item types (Page/Resource/None/etc.) that are still on their SDK defaults here. See
    the portfolio-wide write-up in project memory (builder_stale_obj_glob_pollution) for the full
    mechanism and how this was found/verified in the sibling apps that don't disable Compile globbing.
  -->
  <ItemGroup>
    <Compile Remove="Build\**" />
    <EmbeddedResource Remove="Build\**" />
    <None Remove="Build\**" />
    <Page Remove="Build\**" />
    <ApplicationDefinition Remove="Build\**" />
    <Resource Remove="Build\**" />
  </ItemGroup>
</Project>
